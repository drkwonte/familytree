# Supabase project used for counselor login and genogram storage.
# The publishable key is safe to expose in the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The Gemini key for chat is not read from here: it lives only in the Supabase project's
# Edge Function secrets (GEMINI_API_KEY), so it never reaches the browser bundle.
