# Supabase project used for counselor login and genogram storage.
# The publishable key is safe to expose in the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only key for the chat function. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
